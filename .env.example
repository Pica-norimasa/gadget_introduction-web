# このファイルをコピーして`.env`を作り、各自の値を埋めてください。
#   cp .env.example .env
# `.env`自体はgitignore対象なので、実際の値をここに書いてコミットしないこと。

# AWS RDS(MySQL)への接続文字列。ローカル開発用の値はチームに確認してください
# (このMac自体ではDocker/Homebrew経由のMySQLが現実的でないため、開発用も
# 同じRDSインスタンス上の別データベース(例: draftly_dev)に接続する運用)。
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="mysql://user:password@host:3306/draftly_dev"

# /admin/reportsに入るための合言葉。未設定だと誰もログインできない
# (安全側のデフォルト)。ローカルで試す場合は好きな値に変更してください。
ADMIN_KEY=""

# GitHub Personal Access Token(任意)。app/api/github-preview/route.tsが
# これを使ってGitHub APIを認証付きで叩き、無認証60req/hourの壁を
# 5,000req/hourに引き上げる。publicリポジトリのメタデータ取得のみなので
# スコープ不要。未設定でも動くが、ローカル検証中にレート制限に当たりやすい。
# 発行: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=""

# GitHubでログイン(Auth.js)用のOAuthアプリ credentials。
# 各自 https://github.com/settings/developers で自分用のOAuth Appを作成し、
# 発行された値を入れてください(本番用の値を共有・使い回さないこと)。
#   - Homepage URL: http://localhost:3000
#   - Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Auth.jsがJWTセッションの署名に使う秘密鍵。各自ローカルで生成すればよく、
# 他の人と値を揃える必要はない。
#   openssl rand -base64 33
AUTH_SECRET=""

# 投稿・コメント添付画像の保存先(app/lib/upload.ts)。
# 未設定のままなら/public/uploadsへのローカル保存にフォールバックするので、
# 画像アップロードを試さないなら空のままでよい。設定する場合はAWS認証情報も
# 別途必要(ローカルでは`aws configure`等、本番ではApp RunnerのIAMロール)。
S3_BUCKET_NAME=""
AWS_REGION="ap-northeast-1"
# CloudFront等のカスタムドメイン越しに配信する場合のみ設定(例: https://cdn.example.com)。
# 未設定ならS3の標準URL(https://{bucket}.s3.{region}.amazonaws.com/...)を使う。
S3_PUBLIC_URL_BASE=""
