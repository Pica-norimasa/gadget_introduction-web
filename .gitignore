# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local toolchain (not part of the project)
/.local/

# local Claude Code config (machine-specific)
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Prisma CLI auto-installs assistant-tool skill docs on `prisma init`;
# unrelated to this app, keep them out of the repo.
/.windsurf/
/.agents/
skills-lock.json

# local SQLite dev database
/prisma/dev.db
/prisma/dev.db-journal

# ローカル開発でのアップロード画像の保存先(本番はS3等に置き換える想定)
/public/uploads/
